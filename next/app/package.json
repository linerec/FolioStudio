{
  "name": "folio-studio-next",
  "version": "0.1.0",
  "private": true,
  "description": "Folio Studio (new engine): Rust engine + Electron/React shell",
  "main": "electron/main.cjs",
  "scripts": {
    "build:engine": "cargo build --release --manifest-path ../engine/Cargo.toml -p folio-engine",
    "build:ui": "vite build",
    "build": "npm run build:engine && npm run build:ui",
    "start": "npm run build:ui && electron .",
    "dev": "vite build --watch & electron .",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
