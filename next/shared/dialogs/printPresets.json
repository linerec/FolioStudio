{
  "title": "인쇄 사전 설정",
  "scope": "app",
  "defaults": "printPresets",
  "link": "printSettings",
  "build": "printSettings",
  "computed": "printSettings",
  "className": "print-preset-dialog fields-column",
  "description": "File ▸ Print Presets ▸ Define: the user's print presets (app settings printPresets, never a document): the list (preset, [Default] first and built in) and the chosen preset's name and settings, on InDesign's pages General … Advanced and Summary. The list is the dialog's own until OK (saved, a temporary list): every change of a setting or the name changes the chosen preset in it; newPreset (listAction new) copies the chosen one under a free name (namePrefix, then a number), deletePreset (listAction delete) removes it. Load (import, loadPath: a .json file of Folio print presets) adds the file's presets to the list; Save (export, filePath) writes the chosen one to a file. OK saves the list (userSettings patch printPresets); Cancel drops it. [Default] cannot be changed, renamed or deleted (its fields are off, off says why). A setting that does not apply to the values is off (off; the engine works it out after each change, as InDesign's dialog greys it). Not over an attached MCP connection (an app dialog of the user's settings).",
  "note": [
    "사전 설정은 이 컴퓨터의 사용자 설정에 저장되며 문서에는 들어가지 않습니다. 페이지 범위는 사전 설정에 없고 적용해도 바뀌지 않습니다.",
    { "text": "[기본값]은 기본 제공이라 바꾸거나 지울 수 없습니다. 복제해서 쓰세요.", "when": { "builtIn": true } },
    { "text": "사전 설정 이름이 비어 있거나 이미 있습니다.", "when": { "nameOk": false } }
  ],
  "buttons": [
    { "label": "새로 만들기", "field": "newPreset", "set": { "field": "listAction", "value": "new" } },
    { "label": "삭제", "field": "deletePreset", "set": { "field": "listAction", "value": "delete" }, "disabledWhen": { "builtIn": true } },
    { "label": "불러오기…", "field": "load", "action": "import" },
    { "label": "저장…", "field": "saveFile", "action": "export" }
  ],
  "needs": { "import": ["loadPath"], "export": ["filePath"] },
  "staysOpen": ["import", "export"],
  "unchecked": ["import", "export"],
  "then": { "import": { "saved": { "$at": ["_result", "saved"] } } },
  "okDisabledWhen": { "nameOk": false },
  "tabs": [
    { "id": "general", "label": "일반" },
    { "id": "setup", "label": "설정" },
    { "id": "marksAndBleed", "label": "표시와 도련" },
    { "id": "output", "label": "출력" },
    { "id": "graphics", "label": "그래픽 설정" },
    { "id": "colorManagement", "label": "색상 관리" },
    { "id": "advanced", "label": "고급" },
    { "id": "summary", "label": "요약", "summary": true }
  ],
  "fields": [
    { "name": "preset", "label": "사전 설정", "type": "choice", "source": "printPresets", "size": 5, "default": "[Default]", "everyTab": true, "group": "" },
    { "name": "name", "label": "이름", "type": "text", "default": "[Default]", "maxLength": 200, "everyTab": true, "group": "",
      "messages": { "notEditable": "[기본값]은 기본 제공이라 바꾸거나 지울 수 없습니다. 복제해서 쓰세요.", "notApplicable": "[기본값]은 기본 제공이라 바꾸거나 지울 수 없습니다. 복제해서 쓰세요." } },
    { "name": "saved", "type": "json", "default": [], "hidden": true, "local": true },
    { "name": "listAction", "type": "enum", "default": "", "hidden": true, "local": true, "options": ["", "new", "delete"] },
    { "name": "builtIn", "type": "boolean", "default": true, "hidden": true, "local": true },
    { "name": "nameOk", "type": "boolean", "default": true, "hidden": true, "local": true },
    { "name": "namePrefix", "type": "text", "default": "새 사전 설정", "hidden": true, "local": true, "maxLength": 200 },
    { "name": "loadPath", "label": "불러올 파일", "type": "text", "path": "openFile", "extension": "json", "openAs": "printPreset", "hidden": true, "default": "", "maxLength": 4096 },
    { "name": "filePath", "label": "저장 위치", "type": "text", "path": "saveFile", "extension": "json", "saveAs": "print-presets.json", "hidden": true, "default": "", "maxLength": 4096 }
  ],
  "settingFields": [
    { "key": "printer", "label": "프린터", "everyTab": true, "options": [{ "value": "default", "label": "기본 프린터" }, { "value": "postscriptFile", "label": "PostScript® 파일" }] },
    { "key": "ppd", "label": "PPD", "everyTab": true, "options": [{ "value": "", "label": "장치 독립" }] },
    { "key": "copies", "label": "부수" },
    { "key": "collating", "label": "한 부씩 인쇄" },
    { "key": "reverseOrder", "label": "역순 인쇄" },
    { "key": "sequence", "label": "인쇄 순서", "options": [{ "value": "all", "label": "모든 페이지" }, { "value": "even", "label": "짝수 페이지만" }, { "value": "odd", "label": "홀수 페이지만" }] },
    { "key": "printSpreads", "label": "펼침면으로 인쇄", "radio": ["펼침면", "페이지"] },
    { "key": "printMasterPages", "label": "부모 페이지 인쇄" },
    { "key": "printLayers", "label": "인쇄할 레이어", "options": [{ "value": "allLayers", "label": "모든 레이어" }, { "value": "visibleLayers", "label": "보이는 레이어" }, { "value": "visiblePrintableLayers", "label": "보이는 인쇄 가능 레이어" }] },
    { "key": "printNonprinting", "label": "인쇄 안 되는 개체 인쇄" },
    { "key": "printBlankPages", "label": "빈 페이지 인쇄" },
    { "key": "printGuidesGrids", "label": "보이는 안내선과 기준선 격자 인쇄" },
    { "key": "paperSize", "label": "용지 크기", "options": [{ "value": "Letter", "label": "Letter", "native": true }, { "value": "Legal", "label": "Legal", "native": true }, { "value": "Tabloid", "label": "Tabloid", "native": true }, { "value": "A3", "label": "A3", "native": true }, { "value": "A4", "label": "A4", "native": true }, { "value": "A5", "label": "A5", "native": true }] },
    { "key": "paperWidth", "label": "용지 너비(pt)" },
    { "key": "paperHeight", "label": "용지 높이(pt)" },
    { "key": "printPageOrientation", "label": "페이지 방향", "options": [{ "value": "portrait", "label": "세로 방향 인쇄" }, { "value": "landscape", "label": "가로 방향 인쇄" }, { "value": "reversePortrait", "label": "세로 방향(뒤집음)" }, { "value": "reverseLandscape", "label": "가로 방향(뒤집음)" }] },
    { "key": "paperOffset", "label": "용지 오프셋(pt)" },
    { "key": "paperGap", "label": "용지 간격(pt)" },
    { "key": "paperTransverse", "label": "용지를 가로로 보냄" },
    { "key": "scaleMode", "label": "배율 방식", "options": [{ "value": "scaleWidthHeight", "label": "너비와 높이 배율" }, { "value": "scaleToFit", "label": "용지에 맞춤" }] },
    { "key": "scaleWidth", "label": "너비 배율(%)" },
    { "key": "scaleHeight", "label": "높이 배율(%)" },
    { "key": "scaleProportional", "label": "비율 고정" },
    { "key": "pagePosition", "label": "페이지 위치", "options": [{ "value": "upperLeft", "label": "왼쪽 위에 놓기" }, { "value": "centerHorizontally", "label": "가로 가운데" }, { "value": "centerVertically", "label": "세로 가운데" }, { "value": "centered", "label": "가운데에 놓기" }] },
    { "key": "thumbnails", "label": "축소판" },
    { "key": "thumbnailsPerPage", "label": "한 장에 놓는 수" },
    { "key": "tile", "label": "이어 붙이기" },
    { "key": "tilingType", "label": "이어 붙이는 방식", "options": [{ "value": "auto", "label": "자동 이어 붙이기" }, { "value": "autoJustified", "label": "자동(맞춤)" }, { "value": "manual", "label": "수동 이어 붙이기" }] },
    { "key": "tilingOverlap", "label": "겹침(pt)" },
    { "key": "cropMarks", "label": "자르기 표시" },
    { "key": "bleedMarks", "label": "도련 표시" },
    { "key": "registrationMarks", "label": "맞춤 표시" },
    { "key": "colorBars", "label": "색상 막대" },
    { "key": "pageInformationMarks", "label": "페이지 정보" },
    { "key": "allPrinterMarks", "label": "모든 인쇄 표시" },
    { "key": "markType", "label": "표시 종류", "options": [{ "value": "default", "label": "기본 표시" }, { "value": "jMarkWithCircle", "label": "J 표시(원 포함)" }, { "value": "jMarkWithoutCircle", "label": "J 표시(원 없음)" }] },
    { "key": "markLineWeight", "label": "표시 선 두께" },
    { "key": "markOffset", "label": "페이지에서 표시까지 간격(pt)" },
    { "key": "useDocumentBleedToPrint", "label": "문서 도련 설정 사용" },
    { "key": "bleedTop", "label": "도련 위(pt)" },
    { "key": "bleedBottom", "label": "도련 아래(pt)" },
    { "key": "bleedInside", "label": "도련 안쪽(pt)" },
    { "key": "bleedOutside", "label": "도련 바깥쪽(pt)" },
    { "key": "bleedChain", "label": "도련 네 값을 같게" },
    { "key": "includeSlugToPrint", "label": "슬러그 영역 포함" },
    { "key": "colorOutput", "label": "색상 출력", "options": [{ "value": "compositeLeaveUnchanged", "label": "합성(변경 안 함)" }, { "value": "compositeGray", "label": "합성 회색조" }, { "value": "compositeRgb", "label": "합성 RGB" }, { "value": "compositeCmyk", "label": "합성 CMYK" }, { "value": "separations", "label": "분판" }, { "value": "inRipSeparations", "label": "In-RIP 분판" }] },
    { "key": "textAsBlack", "label": "텍스트를 검정으로" },
    { "key": "trapping", "label": "트랩", "options": [{ "value": "off", "label": "트랩 끔" }, { "value": "applicationBuiltin", "label": "응용 프로그램 내장 트랩" }, { "value": "adobeInRip", "label": "In-RIP 트랩" }] },
    { "key": "flip", "label": "뒤집기", "options": [{ "value": "none", "label": "뒤집지 않음" }, { "value": "horizontal", "label": "좌우로 뒤집기" }, { "value": "vertical", "label": "상하로 뒤집기" }, { "value": "horizontalAndVertical", "label": "좌우와 상하로 뒤집기" }] },
    { "key": "negative", "label": "네거티브" },
    { "key": "screening", "label": "스크린 선수" },
    { "key": "simulateOverprint", "label": "겹침 인쇄 시뮬레이션" },
    { "key": "printCyan", "label": "시안 판 인쇄" },
    { "key": "printMagenta", "label": "마젠타 판 인쇄" },
    { "key": "printYellow", "label": "노랑 판 인쇄" },
    { "key": "printBlack", "label": "검정 판 인쇄" },
    { "key": "cyanAngle", "label": "시안 각도" },
    { "key": "cyanFrequency", "label": "시안 선수" },
    { "key": "magentaAngle", "label": "마젠타 각도" },
    { "key": "magentaFrequency", "label": "마젠타 선수" },
    { "key": "yellowAngle", "label": "노랑 각도" },
    { "key": "yellowFrequency", "label": "노랑 선수" },
    { "key": "blackAngle", "label": "검정 각도" },
    { "key": "blackFrequency", "label": "검정 선수" },
    { "key": "sendImageData", "label": "이미지 데이터 보내기", "options": [{ "value": "allImageData", "label": "모든 이미지 데이터" }, { "value": "optimizedSubsampling", "label": "최적화된 서브샘플링" }, { "value": "proxyImageData", "label": "프록시 이미지" }, { "value": "none", "label": "이미지 데이터 없음" }] },
    { "key": "fontDownloading", "label": "글꼴 다운로드", "options": [{ "value": "none", "label": "글꼴 다운로드 안 함" }, { "value": "complete", "label": "글꼴 전체" }, { "value": "subset", "label": "글꼴 일부" }, { "value": "subsetLarge", "label": "글꼴 일부(큰 글자 포함)" }] },
    { "key": "downloadPPDFonts", "label": "PPD 글꼴 다운로드" },
    { "key": "postscriptLevel", "label": "PostScript® 수준", "options": [{ "value": "level2", "label": "레벨 2" }, { "value": "level3", "label": "레벨 3" }] },
    { "key": "dataFormat", "label": "데이터 형식", "options": [{ "value": "binary", "label": "이진" }] },
    { "key": "sourceSpace", "label": "원본 색 공간", "options": [{ "value": "useDocument", "label": "문서 색 공간" }, { "value": "proofSpace", "label": "교정 색 공간" }] },
    { "key": "profile", "label": "프린터 프로파일" },
    { "key": "intent", "label": "렌더링 의도", "options": [{ "value": "useColorSettings", "label": "색상 설정 사용" }, { "value": "perceptual", "label": "지각적 의도" }, { "value": "saturation", "label": "채도 의도" }, { "value": "relativeColorimetric", "label": "상대 색도계" }, { "value": "absoluteColorimetric", "label": "절대 색도계" }] },
    { "key": "bitmapPrinting", "label": "비트맵으로 인쇄" },
    { "key": "bitmapResolution", "label": "비트맵 해상도(ppi)" },
    { "key": "opiImageReplacement", "label": "OPI 이미지 대체" },
    { "key": "omitEPS", "label": "EPS 생략" },
    { "key": "omitPDF", "label": "PDF 생략" },
    { "key": "omitBitmaps", "label": "비트맵 이미지 생략" },
    { "key": "flattenerPresetName", "label": "투명도 병합 사전 설정" },
    { "key": "ignoreSpreadOverrides", "label": "펼침면 재정의 무시" }
  ]
}
