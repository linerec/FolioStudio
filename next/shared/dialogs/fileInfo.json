{
  "title": "파일 정보",
  "target": "none",
  "defaults": "fileInfo",
  "skipEmpty": true,
  "className": "file-info-dialog",
  "description": "File > File Info: the document's metadata (XMP). It starts from the document's; only what changed is sent (setFileInfo props). Authors and keywords are one per line.",
  "note": "작성자와 키워드는 한 줄에 하나씩 입력하세요.",
  "fields": [
    {
      "name": "documentTitle",
      "label": "문서 제목",
      "type": "text",
      "default": "",
      "maxLength": 10000,
      "group": ""
    },
    {
      "name": "author",
      "label": "작성자",
      "type": "text",
      "multiline": true,
      "rows": 2,
      "default": "",
      "maxLength": 10000,
      "group": ""
    },
    {
      "name": "description",
      "label": "설명",
      "type": "text",
      "multiline": true,
      "rows": 4,
      "default": "",
      "maxLength": 10000,
      "group": ""
    },
    {
      "name": "keywords",
      "label": "키워드",
      "type": "text",
      "multiline": true,
      "rows": 2,
      "default": "",
      "maxLength": 10000,
      "group": ""
    },
    {
      "name": "copyrightNotice",
      "label": "저작권 문구",
      "type": "text",
      "multiline": true,
      "rows": 2,
      "default": "",
      "maxLength": 10000,
      "group": ""
    },
    {
      "name": "copyrightStatus",
      "label": "저작권 상태",
      "type": "enum",
      "default": "Unknown",
      "options": [
        {
          "value": "Unknown",
          "label": "알 수 없음"
        },
        {
          "value": "True",
          "label": "저작권 있음"
        },
        {
          "value": "False",
          "label": "공개 도메인"
        }
      ],
      "group": ""
    }
  ],
  "actions": {
    "ok": [
      {
        "op": "setFileInfo",
        "props": {
          "$changed": true
        }
      }
    ]
  }
}
