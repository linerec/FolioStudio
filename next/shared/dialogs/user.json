{
  "title": "사용자",
  "scope": "app",
  "target": "none",
  "defaults": "userPreferences",
  "className": "user-settings-dialog",
  "description": "File > User (an app dialog): the name and colour notes and tracked changes are marked with. It starts from the app settings (preferences app.userName, app.userColor); applying saves them (userSettings values, the name without the spaces around it).",
  "fields": [
    {
      "name": "app.userName",
      "label": "이름",
      "type": "text",
      "default": "",
      "required": true,
      "trim": true,
      "maxLength": 256,
      "group": ""
    },
    {
      "name": "app.userColor",
      "label": "색상",
      "type": "enum",
      "default": "GOLD",
      "options": [
        {
          "value": "LIGHT_BLUE",
          "label": "연한 파랑"
        },
        {
          "value": "RED",
          "label": "빨강"
        },
        {
