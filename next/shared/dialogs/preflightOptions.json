{
  "title": "사전 검사 옵션",
  "target": "none",
  "defaults": "preflightOptions",
  "description": "Preflight panel > Preflight Options: the working profile (a profile name of the document or none), the page range (empty = every page; numbers from 1 and a-b ranges), the layers to check, the pasteboard and non-printing switches and preflight off. `profiles` is the document's profile list, carried whole and sent back with the chosen working profile.",
  "fields": [
    {
      "name": "profiles",
      "type": "json",
      "default": [],
      "hidden": true
    },
    {
      "name": "active",
      "label": "작업 중인 프로필",
      "type": "choice",
      "source": "preflightProfiles",
      "none": "기본값",
      "default": ""
    },
    {
      "name": "page_range",
      "label": "페이지 범위",
      "type": "text",
      "format": "pageRange",
      "placeholder": "1,3-5",
      "default": "",
      "maxLength": 200
    },
    {
      "name": "layers",
      "label": "검사할 레이어",
      "type": "enum",
      "default": "visiblePrintable",
      "options": [
        {
          "value": "all",
          "label": "모든 레이어"
        },
        {
          "value": "visible",
          "label": "보이는 레이어"
        },
        {
          "value": "visiblePrintable",
          "label": "보이고 인쇄되는 레이어"
        }
      ]
    },
    {
      "name": "include_pasteboard",
      "label": "대지 개체 포함",
      "type": "boolean",
      "default": false
    },
    {
      "name": "include_nonprinting",
      "label": "비인쇄 개체 포함",
      "type": "boolean",
      "default": false
    },
    {
      "name": "off",
      "label": "사전 검사 끄기",
      "type": "boolean",
      "default": false
    }
  ],
  "note": "비워 두면 모든 페이지를 검사합니다. 문서의 첫 페이지가 1입니다.",
  "actions": {
    "ok": [
      {
        "op": "setPreflightProfiles",
        "state": {
          "profiles": "$profiles",
          "active": "$active"
        }
      },
      {
        "op": "setPreflightSettings",
        "state": {
          "page_range": "$page_range",
          "layers": "$layers",
          "include_pasteboard": "$include_pasteboard",
          "include_nonprinting": "$include_nonprinting",
          "off": "$off"
        }
      }
    ]
  }
}
