{
  "edit.delete": {"description":"Delete the page items named by ID.","example":{"ids":["item1"]},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}}},"required":["ids"],"additionalProperties":false}},
  "edit.duplicate": {"description":"Duplicate items and optionally offset the copies in points.","example":{"ids":["item1"],"by":[12,0]},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"by":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2}},"required":["ids"],"additionalProperties":false}},
  "edit.group": {"description":"Group items on the same spread.","example":{"ids":["item1","item2"]},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}}},"required":["ids"],"additionalProperties":false}},
  "edit.ungroup": {"description":"Ungroup by group ID. rememberLayers restores the members' original layers.","example":{"id":"group1"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"rememberLayers":{"type":"boolean"}},"required":["id"],"additionalProperties":false}},
  "edit.arrange": {"description":"Change stacking order on the item's layer.","example":{"id":"item1","how":"front"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"how":{"type":"string","enum":["front","forward","backward","back"]}},"required":["id","how"],"additionalProperties":false}},
  "edit.move": {"description":"Translate items by horizontal and vertical distances in points.","example":{"ids":["item1"],"by":[12,-6]},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"by":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2}},"required":["ids","by"],"additionalProperties":false}},
  "edit.align": {"description":"Align item edges or centers. Supply key for alignment to a key object.","example":{"ids":["item1","item2"],"how":"left"},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"how":{"type":"string","enum":["left","hCenter","right","top","vCenter","bottom"]},"bounds":{"type":"string","enum":["selection","margin","page","spread","key","bleed"]},"key":{"type":"string"}},"required":["ids","how"],"additionalProperties":false}},
  "edit.distribute": {"description":"Distribute item edges, centers or spaces. An explicit gap is in points.","example":{"ids":["item1","item2","item3"],"how":"hSpace"},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"how":{"type":"string","enum":["left","hCenter","right","top","vCenter","bottom","hSpace","vSpace"]},"bounds":{"type":"string","enum":["selection","margin","page","spread","key","bleed"]},"key":{"type":"string"},"gap":{"type":"number"}},"required":["ids","how"],"additionalProperties":false}},
  "edit.setItem": {"description":"Lock, unlock, show or hide a page item.","example":{"id":"item1","locked":true},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"locked":{"type":"boolean"},"visible":{"type":"boolean"}},"required":["id"],"additionalProperties":false}},
  "edit.applyObjectStyle": {"description":"Apply an object style by ID. Set clear to clear local overrides.","example":{"ids":["item1"],"style":"ObjectStyle/$ID/[None]"},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"style":{"type":"string"},"clear":{"type":"boolean"}},"required":["ids","style"],"additionalProperties":false}},
  "edit.applyObjectStyleToContent": {"description":"Apply an object style to placed content.","example":{"ids":["item1"],"style":"ObjectStyle/$ID/[None]","clear":false}},
  "edit.setBlending": {"description":"Set opacity, blend mode or group blending at the selected level.","example":{"ids":["item1"],"level":"object","opacity":75},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"level":{"type":"string","enum":["object","stroke","fill","text","graphic"]},"opacity":{"type":"number","minimum":0,"maximum":100},"mode":{"type":"string"},"isolate":{"type":"boolean"},"knockout":{"type":"boolean"}},"required":["ids","level"],"additionalProperties":false}},
  "edit.setEffect": {"description":"Enable or adjust an effect on the object, text, graphic, stroke or fill.","example":{"ids":["item1"],"level":"object","effect":"dropShadow","on":true},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"level":{"type":"string","enum":["object","stroke","fill","text","graphic"]},"effect":{"type":"string","enum":["dropShadow","innerShadow","outerGlow","innerGlow","bevelAndEmboss","satin","basicFeather","directionalFeather","gradientFeather"]},"on":{"type":"boolean"},"values":{"type":"object"}},"required":["ids","level","effect"],"additionalProperties":false}},
  "edit.fit": {"description":"Fit or center the graphic in its frame, or resize the frame to the content.","example":{"id":"frame1","how":"proportionally"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"how":{"type":"string","enum":["proportionally","fill","contentToFrame","frameToContent","center"]}},"required":["id","how"],"additionalProperties":false}},
  "edit.insertPages": {"description":"Insert pages before a page ID, or append if omitted. master is an optional parent spread ID.","example":{"count":1},"inputSchema":{"type":"object","properties":{"count":{"type":"integer","minimum":1,"maximum":9999},"before":{"type":"string"},"master":{"type":"string"}},"required":["count"],"additionalProperties":false}},
  "edit.deletePages": {"description":"Delete the listed document pages.","example":{"pages":["page2"]},"inputSchema":{"type":"object","properties":{"pages":{"type":"array","minItems":1,"items":{"type":"string"}}},"required":["pages"],"additionalProperties":false}},
  "edit.duplicateSpread": {"description":"Duplicate a spread and its pages and items. Use the spread ID from documentInfo.","example":{"spread":"spread1"},"inputSchema":{"type":"object","properties":{"spread":{"type":"string"}},"required":["spread"],"additionalProperties":false}},
  "edit.applyMaster": {"description":"Apply a parent spread to the pages. Omit master to remove their parent.","example":{"pages":["page1"],"master":"master1"},"inputSchema":{"type":"object","properties":{"pages":{"type":"array","minItems":1,"items":{"type":"string"}},"master":{"type":"string"}},"required":["pages"],"additionalProperties":false}},
  "edit.newParent": {"description":"Create a parent spread. basedOn is an optional parent spread ID.","example":{"name":"Chapter","prefix":"B","pages":1},"inputSchema":{"type":"object","properties":{"pages":{"type":"integer","minimum":1,"maximum":10},"prefix":{"type":"string"},"name":{"type":"string"},"basedOn":{"type":"string"}},"required":[],"additionalProperties":false}},
  "edit.saveAsParent": {"description":"Create a parent from an existing document spread.","example":{"spread":"spread1"}},
  "edit.setSection": {"description":"Set section numbering at a page. Omit start for automatic numbering.","example":{"page":"page1","start":1,"style":"Arabic","prefix":"A-","includePrefix":true},"inputSchema":{"type":"object","properties":{"page":{"type":"string"},"start":{"type":"integer","minimum":1,"maximum":999999},"style":{"type":"string","enum":["Arabic","UpperRoman","LowerRoman","UpperLetters","LowerLetters"]},"prefix":{"type":"string"},"includePrefix":{"type":"boolean"},"marker":{"type":"string"}},"required":["page","style"],"additionalProperties":false}},
  "edit.deleteSection": {"description":"Remove the section starting at the given page.","example":{"page":"page2"}},
  "edit.newSwatch": {"description":"Create a named process or spot color from channel values in the given color space.","example":{"name":"Ocean","space":"CMYK","value":[100,30,0,10]},"inputSchema":{"type":"object","properties":{"name":{"type":"string"},"space":{"type":"string","enum":["CMYK","RGB","LAB","HSB"]},"value":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":4},"spot":{"type":"boolean"}},"required":["name","space","value"],"additionalProperties":false}},
  "edit.setSwatch": {"description":"Rename or change a color swatch and update its use throughout the document.","example":{"id":"Color/Ocean","rename":"Sea"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"value":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":4},"space":{"type":"string","enum":["CMYK","RGB","LAB"]},"spot":{"type":"boolean"},"rename":{"type":"string"}},"required":["id"],"additionalProperties":false}},
  "edit.deleteSwatch": {"description":"Delete a swatch, replacing its uses with the given swatch ID.","example":{"id":"Color/Ocean","replace":"Color/Black"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"replace":{"type":"string"}},"required":["id","replace"],"additionalProperties":false}},
  "edit.newTint": {"description":"Create a tint from a base swatch and a percentage.","example":{"base":"Color/Black","tint":40},"inputSchema":{"type":"object","properties":{"base":{"type":"string"},"tint":{"type":"number","minimum":0,"maximum":100}},"required":["base","tint"],"additionalProperties":false}},
  "edit.setPaint": {"description":"Apply swatch IDs and tints to a fill or stroke. Stroke weight is in points.","example":{"ids":["item1"],"fill":"Color/Paper","stroke":"Color/Black","strokeWeight":1},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"fill":{"type":"string"},"fillTint":{"type":"number"},"stroke":{"type":"string"},"strokeTint":{"type":"number"},"strokeWeight":{"type":"number"}},"required":["ids"],"additionalProperties":false}},
  "edit.newGradient": {"description":"Create a gradient from ordered swatch stops. Locations and midpoints are percentages.","example":{"name":"Fade","kind":"Linear","stops":[{"color":"Color/Paper","location":0,"midpoint":50},{"color":"Color/Black","location":100,"midpoint":50}]},"inputSchema":{"type":"object","properties":{"name":{"type":"string"},"kind":{"type":"string","enum":["Linear","Radial"]},"stops":{"type":"array","minItems":2,"items":{"type":"object","properties":{"color":{"type":"string"},"location":{"type":"number","minimum":0,"maximum":100},"midpoint":{"type":"number","minimum":13,"maximum":87}},"required":["color","location","midpoint"],"additionalProperties":false},"maxItems":256}},"required":["name","kind","stops"],"additionalProperties":false}},
  "edit.editGradient": {"description":"Change a gradient swatch's name, gradient type or ordered stops.","example":{"id":"Gradient/Fade","kind":"Radial"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"rename":{"type":"string"},"kind":{"type":"string","enum":["Linear","Radial"]},"stops":{"type":"array","minItems":2,"items":{"type":"object","properties":{"color":{"type":"string"},"location":{"type":"number","minimum":0,"maximum":100},"midpoint":{"type":"number","minimum":13,"maximum":87}},"required":["color","location","midpoint"],"additionalProperties":false},"maxItems":256}},"required":["id"],"additionalProperties":false}},
  "edit.setGradientGeometry": {"description":"Change the applied gradient's origin, angle in degrees or length in points.","example":{"id":"item1","angle":45,"length":72},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"stroke":{"type":"boolean"},"angle":{"type":"number"},"length":{"type":"number"},"start":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2}},"required":["id"],"additionalProperties":false}},
  "edit.newLayer": {"description":"Create a layer above the specified layer, or above the active layer.","example":{"name":"Captions"},"inputSchema":{"type":"object","properties":{"name":{"type":"string"},"color":{"type":"string"},"above":{"type":"string"}},"required":[],"additionalProperties":false}},
  "edit.setLayer": {"description":"Rename a layer or change its visibility, lock, print or guide settings.","example":{"id":"layer1","name":"Text","visible":true},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"visible":{"type":"boolean"},"locked":{"type":"boolean"},"printable":{"type":"boolean"},"color":{"type":"string"},"showGuides":{"type":"boolean"},"lockGuides":{"type":"boolean"}},"required":["id"],"additionalProperties":false}},
  "edit.moveLayer": {"description":"Reorder a layer relative to another. Specify either above or below.","example":{"id":"layer2","below":"layer1"},"inputSchema":{"type":"object","properties":{"id":{"type":"string"},"above":{"type":"string"},"below":{"type":"string"}},"required":["id"],"additionalProperties":false}},
  "edit.toLayer": {"description":"Move items to a document layer by ID.","example":{"ids":["item1"],"layer":"layer2"},"inputSchema":{"type":"object","properties":{"ids":{"type":"array","minItems":1,"items":{"type":"string"}},"layer":{"type":"string"}},"required":["ids","layer"],"additionalProperties":false}},
  "edit.setPreflightProfiles": {"description":"Replace the document profile list and active profile. Read preflightProfiles before changing it.","example":{"state":{"active":"Press","profiles":[{"name":"Press","disabled_rules":[],"parameters":{}}]}}},
  "edit.setPreflightSettings": {"description":"Replace document preflight settings. Read preflightSettings first to preserve other options.","example":{"state":{"off":false}}}
}
