      {"op":"guideOptions","page":0,"props":{"locked":true}},
      {"op":"guideOptions","page":0,"props":{"locked":false}},
      {"op":"guideMoveBy","page":0,"delta":[10,30]}
    ]},
    {"name":"guides2-defaults", "steps":[
      {"op":"viewPref","name":"rulerGuidesThreshold","value":35},
      {"op":"viewPref","name":"rulerGuidesColor","value":"Magenta"},
