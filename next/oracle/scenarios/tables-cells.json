{
 "fixture": "tables",
 "about": "Table > Cell Options > Diagonal Lines and Graphic, Convert Cell to Graphic Cell / Text Cell: the DOM's cell properties (diagonal lines, cell type, graphic insets, clipping) one by one; the cell attributes InDesign writes where they differ from the default. Convert Cell to Graphic Cell is the Table menu action 66869 (66868: to Text Cell), enabled with the cursor in an empty cell (a cell with text: disabled in the cursor and the cell selection).",
 "scenarios": [
  {
   "name": "cell-diag-one",
   "steps": [
    {
     "op": "table",
     "target": "tbl",
     "do": "cellProps",
     "cell": [
      2,
      1
     ],
     "props": {
      "topLeftDiagonalLine": true,
      "diagonalLineStrokeWeight": 2,
      "diagonalLineStrokeColor": "Oracle Orange"
     }
    }
   ]
  },
  {
   "name": "cell-diag-default",
   "steps": [
    {
     "op": "table",
     "target": "tbl",
     "do": "cellProps",
     "cell": [
      2,
      1
     ],
     "props": {
      "topRightDiagonalLine": true
     }
    }
   ]
  },
  {
   "name": "cell-diag-both",
   "steps": [
    {
     "op": "table",
     "target": "tbl",
     "do": "cellProps",
     "cell": [
      2,
      2
     ],
     "props": {
      "topLeftDiagonalLine": true,
      "topRightDiagonalLine": true,
      "diagonalLineInFront": true,
      "diagonalLineStrokeWeight": 1.5,
      "diagonalLineStrokeTint": 50,
      "diagonalLineStrokeColor": "Oracle Blue",
      "diagonalLineStrokeType": "Dashed"
     }
    }
   ]
  },
  {
   "name": "cell-to-graphic",
