          }
        }
      ]
    },
    {
      "name": "oo-fitting-mode",
      "steps": [
        {
          "op": "setFrameFitting",
          "target": "img",
          "props": {
            "fittingOnEmptyFrame": "Proportionally"
          }
        }
      ]
    },
    {
      "name": "oo-fitting-auto",
      "steps": [
        {
          "op": "setFrameFitting",
          "target": "img",
          "props": {
            "autoFit": true
          }
        }
      ]
    }
  ]
