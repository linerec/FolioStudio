          "op": "set",
          "target": "tf",
          "props": {
            "textFramePreferences": {
              "autoSizingType": "AutoSizingTypeEnum.HEIGHT_ONLY"
            }
          }
        },
        {
          "op": "insertText",
          "target": "tf",
          "at": 0,
          "text": "First line added.\rSecond line added.\r"
        },
        {
          "op": "recompose"
        }
      ]
    },
    {
      "name": "as-then-delete",
      "steps": [
        {
          "op": "set",
          "target": "tf",
          "props": {
            "textFramePreferences": {
              "autoSizingType": "AutoSizingTypeEnum.HEIGHT_ONLY"
