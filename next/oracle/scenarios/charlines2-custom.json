      "steps": [
        {
          "op": "strokeStyleSave",
          "style": {
            "id": "",
            "name": "Char dash",
            "kind": "DashedStrokeStyle",
            "values": [
              8,
              4
            ],
            "adjustment": "DashesAndGaps",
            "cap": "ButtEndCap"
          }
        },
        {
          "op": "textFormat",
          "target": "format",
          "start": 0,
          "end": 18,
          "props": {
            "underline": true,
            "strikeThru": true,
            "underlineWeight": 2,
            "underlineOffset": 6,
            "underlineColor": "Color/Black",
            "underlineType": "DashedStrokeStyle/Char dash",
