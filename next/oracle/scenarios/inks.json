     }
    }
   ]
  },
  {
   "name": "ink-all-spots",
   "steps": [
    {
     "op": "swatchNew",
     "name": "PMS 485",
     "model": "spot",
     "space": "cmyk",
     "value": [
      0,
      95,
      100,
      0
     ]
    },
    {
     "op": "inkAllSpots",
     "on": true
    }
   ]
  },
  {
   "name": "ink-convert-used",
   "steps": [
    {
     "op": "inkSet",
     "name": "Oracle Spot",
     "props": {
